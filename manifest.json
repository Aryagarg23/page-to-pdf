{
  "manifest_version": 3,
  "name": "Page to PDF",
  "version": "0.2.0",
  "description": "Save any web page as a PDF. Pages or one long page, your own scale and page size, wait for animations, hide what you don't want.",
  "minimum_chrome_version": "116",
  "permissions": [
    "debugger",
    "downloads",
    "storage",
    "offscreen",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Save page as PDF",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "commands": {
    "save-pdf": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Save the current tab as PDF with your last settings"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
